# Puerto en el que correrá el servidor Express
PORT=5000

# Configuración de base de datos PostgreSQL + PostGIS
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=spot_db
DB_PASSWORD=my_secure_password
DB_PORT=5432

# Claves de la API de Stripe
# STRIPE_SECRET_KEY: Clave secreta para transacciones y suscripciones en Stripe Connect
# STRIPE_WEBHOOK_SECRET: Secreto de validación para notificaciones asíncronas de Stripe
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Firebase Admin SDK (Cloud Messaging)
# FIREBASE_PROJECT_ID: Identificador de proyecto para notificaciones push FCM
# FIREBASE_CREDENTIALS_PATH: Ruta al archivo JSON de credenciales de cuenta de servicio de Firebase
FIREBASE_PROJECT_ID=spot-firebase-project
FIREBASE_CREDENTIALS_PATH=./config/firebase-service-account.json
